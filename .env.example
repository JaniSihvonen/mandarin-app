# Copy this file to .env and fill in real values.
# .env is git-ignored. Never commit real keys.
#
# Variables prefixed with VITE_ are bundled into the client and are
# therefore PUBLIC. Anything secret must stay server-side, in a
# Netlify Function environment variable without the VITE_ prefix.

# --- Step 5: Supabase ---
# Anon key is safe to expose; row level security is what protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Step 8: text to speech (Azure AI Speech), used by the seed script ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- Step 9: sentence generation, used only by the Netlify Function ---
LLM_API_KEY=
